# Server configuration
PORT=8080

# Environment configuration
LOG_LEVEL=INFO

# Resume configuration
RESUME_PATH=data/resume.json

# OpenRouter API configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
# LLM model - Gemini 2.5 Flash is cheap and reliable
# Other options: google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet, openai/gpt-4o
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT=60.0

# Database configuration
# PostgreSQL via Docker Compose (required):
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_dev_password@localhost:5432/resume_chatbot
# Neon (production) - use pooled connection string with -pooler suffix:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_ECHO=false
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3
